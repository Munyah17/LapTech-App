generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
  COUNTRYWIDE // FedEx pay-forward, client pays courier at collection
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ECOCASH
  BANK_TRANSFER
  IN_STORE
  PAYNOW
  WALLET
}

enum WalletTxType {
  TOPUP      // admin credit
  PURCHASE   // order payment (debit)
  GIFT_OUT   // sent as gift (debit)
  GIFT_IN    // received as gift (credit)
  ADJUSTMENT // manual admin adjustment
}

enum PaymentStatus {
  UNPAID
  AWAITING // Paynow initiated, awaiting confirmation
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {    
  PENDING
  CONFIRMED    
  IN_PROGRESS
  COMPLETED
  CANCELLED    
}    

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CLIENT)
  createdAt    DateTime  @default(now())
  orders       Order[]
  bookings     Booking[]
  wallet       Wallet?
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  specs           String? // JSON string of key/value specs
  price           Float
  compareAtPrice  Float?
  stock           Int      @default(0)
  image           String?
  badge           String? // e.g. "Best Seller", "New", "Sale"
  featured        Boolean  @default(false)
  rating          Float    @default(5)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  createdAt       DateTime @default(now())
  items           OrderItem[]
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  customerName   String
  email          String
  phone          String
  subtotal       Float
  deliveryFee    Float          @default(0)
  total          Float
  deliveryMethod DeliveryMethod @default(PICKUP)
  address        String?
  suburb         String?
  zoneName       String?
  paymentMethod  PaymentMethod  @default(CASH_ON_DELIVERY)
  paymentStatus  PaymentStatus  @default(UNPAID)
  paymentRef     String? // Paynow poll URL / reference
  status         OrderStatus    @default(PENDING)
  city           String? // countrywide destination town/city
  notes          String?
  createdAt      DateTime       @default(now())
  items          OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Float
  qty       Int
}

model Booking {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  name          String
  phone         String
  email         String?
  device        String
  serviceType   String
  description   String?
  preferredDate String?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

model DeliveryZone {
  id      String  @id @default(cuid())
  name    String
  minKm   Float
  maxKm   Float
  fee     Float
  suburbs String // comma-separated suburb names
  active  Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  image       String // banner image URL or /uploads path
  ctaLabel    String   @default("Shop Now")
  ctaHref     String   @default("/shop")
  cta2Label   String?
  cta2Href    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String? // uploaded illustration URL
  category    String // grouping shown on services page
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String
  vehicle   String // e.g. "Motorbike", "Sedan — InDrive"
  zones     String? // comma-separated zones they cover
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String // ORDER, BOOKING, PAYMENT, CONTACT
  title     String
  body      String
  link      String? // admin deep-link e.g. /admin/orders
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String       @id @default(cuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      WalletTxType
  amount    Float // signed: + credit, - debit
  note      String?
  ref       String? // order number / counterparty email
  createdAt DateTime     @default(now())
}

// Marketing / CRM — manually captured walk-in & prospect contacts
model Lead {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  address         String?
  businessName    String?
  businessContact String?
  businessAddress String?
  notes           String?
  interests       String? // derived summary of what they like
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Behaviour tracking for product recommendations (views, cart adds, purchases)
// Plain log table — queried by userId/sessionId/categoryId, no relations needed.
model Interaction {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String? // anonymous tracking
  productId  String?
  categoryId String?
  type       String // VIEW, CART_ADD, PURCHASE
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([categoryId])
}
