# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/laptech
DIRECT_URL=postgresql://user:password@host:5432/laptech

# Session signing secret — use a long random string in production
AUTH_SECRET=change-me

# Public site URL (used for Paynow callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paynow Zimbabwe
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# SMTP (order/booking emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LapTech <info@laptech.co.zw>"
ADMIN_NOTIFY_EMAIL=info@laptech.co.zw
